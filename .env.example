HOST=127.0.0.1
PORT=8025
# Only these From: domains may send (comma separated). Empty = any.
ALLOWED_FROM_DOMAINS=

# Central MySQL DB (the one OpenDKIM reads). Needs a user that can write, not opendkim_ro.
DB_HOST=my-sql-open-dkim-mail-service.c.aivencloud.com
DB_PORT=23356
DB_NAME=defaultdb
DB_USER=dkim_admin
DB_PASSWORD=
# Optional: Aiven CA cert to check the server cert. Without it, TLS is used unchecked.
DB_SSL_CA=
