HOST=0.0.0.0
PORT=8025
# "production" on mail servers, "local" on a developer PC (shown in the nodes table)
APP_ENV=production

# DNS records stored for every new domain (defaults shown)
# SPF_RECORD="v=spf1 include:spf.metrovps.art ~all"     (keep the quotes: run.sh sources this file)
# DMARC_RECORD="v=DMARC1; p=none; adkim=r; aspf=r"

# Central MariaDB DB (the one OpenDKIM reads). Needs a user that can write, not opendkim_ro.
# Used by the app and by alembic. URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
DATABASE_URL=
